rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Allow all users to read files (for public gallery)
    match /{allPaths=**} {
      allow read: if true;
    }
    
    // Temporarily allow all operations for debugging
    match /uploads/{allPaths=**} {
      allow read, write, delete: if request.auth != null;
    }
  }
}
